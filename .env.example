# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://mediverse.click

# Server-only secrets. NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (any OpenAI-compatible chat API)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Payments (links come from your payment provider)
STARTER_PAYMENT_LINK=
PROFESSIONAL_PAYMENT_LINK=
PAYMENT_WEBHOOK_SECRET=

# Comma-separated emails allowed to verify payments at /admin/payments
PLATFORM_ADMIN_EMAILS=
